# =========================================================
# MODELO de configuração. Copie este arquivo para ".env" e
# troque a senha. O ".env" NUNCA vai para o Git (RNF-05).
# =========================================================

# --- Lido pelo PostgreSQL dentro do Docker (cria o banco) ---
POSTGRES_USER=lucy
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=salao

# --- Lido pelo servidor Node para se conectar ao banco ---
# (mesmo usuário, senha e banco de cima)
PGHOST=localhost
PGPORT=5432
PGUSER=lucy
PGPASSWORD=troque-esta-senha
PGDATABASE=salao

# --- Servidor ---
PORT=3000
